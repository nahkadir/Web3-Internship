# --- App ---
NODE_ENV=development          # use "production" when deployed
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/marketplace   # Atlas string in production
JWT_SECRET=                   # 32+ random characters
FRONTEND_URL=http://localhost:5173   # comma-separate multiple allowed origins
BACKEND_URL=http://localhost:5000
TRUST_PROXY_HOPS=1

# --- Payments ---
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=false     # true only for demo deployments
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=       # e.g. whsec_ + 32 random bytes (hex)
PAYMENT_CURRENCY=PKR
COMMISSION_RATE=0.10
PAYMENT_WINDOW_MINUTES=30